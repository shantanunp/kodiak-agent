{
  "name": "kodiak-agent",
  "version": "0.1.0",
  "description": "Orchestrator for Java mapping discovery, indexing, and pipeline visualization",
  "type": "module",
  "scripts": {
    "ast": "tsx indexer/cli.ts",
    "index-mappings": "tsx indexer/cli.ts",
    "scan": "tsx src/orchestrator/scanRepo.ts",
    "scan:incremental": "tsx src/orchestrator/incrementalScan.ts",
    "poll": "tsx src/poll/cron.ts",
    "read-source": "tsx src/tools/readSource.ts",
    "latest-sha": "tsx src/tools/getLatestCommitSha.ts",
    "golden:capture": "tsx validator/golden-dataset/capture.ts",
    "label": "tsx translator/cli.ts",
    "cache:clear": "tsx translator/cache/clear-cli.ts",
    "view:export": "tsx translator/export-view.ts",
    "ui:serve": "tsx ui/serve.ts",
    "view:serve": "tsx ui/serve.ts",
    "schema:validate": "tsx schema/cli-validate.ts",
    "view": "npm run view:export -- --mapper demo-ai-recognition-mapper --label && npm run view:serve",
    "build:indexer": "cd indexer && JAVA_HOME=\"${JAVA_HOME:-$(cd .. && pwd)/.jdk}\" ./gradlew shadowJar"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@octokit/rest": "^21.1.1",
    "dotenv": "^16.4.7",
    "minimatch": "^10.0.1",
    "node-cron": "^3.0.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
