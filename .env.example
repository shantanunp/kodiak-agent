# Fine-grained PAT: Contents Read-only on target repo
GITHUB_TOKEN=

# Optional overrides (defaults derived from registry/mapping-registry.yaml)
# Target repo: https://github.com/shantanunp/Kmismomapper
# GITHUB_OWNER=shantanunp
# GITHUB_REPO=Kmismomapper

CACHE_DIR=./.cache
POLL_INTERVAL_MINUTES=15

# Path to Java indexer shadow jar (built via npm run build:indexer)
KODIAK_INDEXER_JAR=./indexer/build/libs/kodiak-indexer.jar

# github-mcp-server binary (optional; REST fallback used if MCP unavailable)
# GITHUB_MCP_COMMAND=github-mcp-server

# --- Phase 2: Gemini (Google AI Studio REST API) ---
# Key from https://aistudio.google.com/apikey — paste into .env only, never commit.
# Same API as: curl generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
