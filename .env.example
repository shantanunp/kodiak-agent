# Fine-grained PAT: Contents Read-only on target repo
GITHUB_TOKEN=

# Optional overrides (defaults derived from registry/mapping-registry.yaml)
# Target repo: https://github.com/shantanunp/Kmismomapper
# GITHUB_OWNER=shantanunp
# GITHUB_REPO=Kmismomapper

CACHE_DIR=./.cache
POLL_INTERVAL_MINUTES=15

# Path to Java indexer shadow jar (built via npm run build:indexer)
KODIAK_INDEXER_JAR=./indexer/build/libs/kodiak-indexer.jar

# github-mcp-server binary (optional; REST fallback used if MCP unavailable)
# GITHUB_MCP_COMMAND=github-mcp-server

# --- Phase 2: model provider (swap vendor via endpoint + key + style) ---
# Required:
MODEL_API_KEY=
# Optional:
MODEL_NAME=gemini-flash-latest
MODEL_TEMPERATURE=0
# gemini = Google generateContent | openai = OpenAI-compatible /chat/completions
MODEL_API_STYLE=gemini
MODEL_BASE_URL=https://generativelanguage.googleapis.com
# OpenAI / office gateway example:
# MODEL_API_STYLE=openai
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# Legacy aliases (still work if MODEL_* unset):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TEMPERATURE=0
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
