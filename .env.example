# Fine-grained PAT: Contents Read-only on target repo (scan / remote label)
GITHUB_TOKEN=

# Optional overrides (defaults derived from registry/mapping-registry.yaml)
# Target repo: https://github.com/your-org/your-mapper-repo
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-mapper-repo

CACHE_DIR=./.cache
POLL_INTERVAL_MINUTES=15

# github-mcp-server binary (optional; REST fallback used if MCP unavailable)
# GITHUB_MCP_COMMAND=github-mcp-server

# Required for UI "Build with AI" (writes mapper source/tests under this checkout).
# Git commit/PR is a later phase — this path only needs to be a readable/writable tree.
# MAPPER_WORKTREE=/path/to/your-mapper-repo

# --- Phase 2: model provider (swap vendor via endpoint + key + style) ---
# Required (copilot also accepts COPILOT_TOKEN / GITHUB_TOKEN):
MODEL_API_KEY=
# Optional:
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0
# openai | claude | copilot
MODEL_API_STYLE=openai
MODEL_BASE_URL=https://api.openai.com/v1
# Anthropic Claude example:
# MODEL_API_STYLE=claude
# MODEL_BASE_URL=https://api.anthropic.com/v1
# MODEL_NAME=claude-sonnet-4-5
# MODEL_API_KEY=sk-ant-...
# (ANTHROPIC_API_KEY also accepted)
# GitHub Copilot chat completions:
# MODEL_API_STYLE=copilot
# MODEL_BASE_URL=https://api.githubcopilot.com
# MODEL_NAME=gpt-4o
# MODEL_API_KEY=...   # or COPILOT_TOKEN / GITHUB_TOKEN
# Optional override if your org requires a specific integration id:
# COPILOT_INTEGRATION_ID=copilot-developer-cli
