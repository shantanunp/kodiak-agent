{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*",
    "translator/**/*",
    "schema/**/*",
    "ui/serve.ts",
    "analyzer/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "ui"
  ]
}
